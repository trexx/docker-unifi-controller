{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "docker:enableMajor",
    "docker:pinDigests",
    "default:automergeDigest",
    "default:automergeMinor",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchDepTypes":[
        "stage"
      ]
    },
    {
      "enabled": false,
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "enabled": true,
      "matchFileNames": [
        ".github/workflows/unifi-version.yml"
      ],
      "matchManagers": [
        "github-actions"
      ]
    }
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions"
  ]
}
